# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Set to true after setup-db.sql has been applied.
NEXT_PUBLIC_SUPABASE_SCHEMA_READY="false"
NEXT_PUBLIC_EVIDENCE_RADAR_READY="false"

# Evidence Radar (server-only; never prefix these secrets with NEXT_PUBLIC_)
EVIDENCE_RADAR_CRON_SECRET="use-a-long-random-secret"
EVIDENCE_RADAR_AUTO_PUBLISH="false"
EVIDENCE_RADAR_COLLECTION_ENABLED="false"
EVIDENCE_RADAR_ANALYSIS_ENABLED="false"
EVIDENCE_RADAR_GOLDEN_SAMPLE_COUNT="0"
EVIDENCE_RADAR_GEMINI_MODEL="gemini-3.5-flash"
EVIDENCE_RADAR_ALLOW_PAID_TIKTOK_COLLECTION="false"
EVIDENCE_RADAR_BRIGHT_DATA_ENABLED="false"
GEMINI_API_KEY="your-gemini-api-key"
TIKTOK_COLLECTOR_WEBHOOK_SECRET="use-a-long-random-secret"

# Public site metadata
NEXT_PUBLIC_SITE_URL="https://360dodep.vn"
NEXT_PUBLIC_GA_ID=""
