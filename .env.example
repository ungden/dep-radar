# Copy to .env.local. Values below are for the local Supabase stack
# (supabase start prints them; `supabase status -o env` shows them again).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Absolute origin for metadata, robots.txt and sitemap.xml.
# Required for a production build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identity verification with a vision AI. Missing key = the feature says it is off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Salt for the one-way hash of a CCCD number, so one card cannot verify
# several accounts. Any long random string; keep it stable.
IDENTITY_HASH_SALT=
