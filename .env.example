# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Set to true after setup-db.sql has been applied.
NEXT_PUBLIC_SUPABASE_SCHEMA_READY="false"
NEXT_PUBLIC_EVIDENCE_RADAR_READY="false"

# Evidence Radar (server-only; never prefix these secrets with NEXT_PUBLIC_)
EVIDENCE_RADAR_CRON_SECRET="use-a-long-random-secret"
EVIDENCE_RADAR_AUTO_PUBLISH="false"
EVIDENCE_RADAR_COLLECTION_ENABLED="false"
EVIDENCE_RADAR_GOLDEN_SAMPLE_COUNT="0"
EVIDENCE_RADAR_GEMINI_MODEL="gemini-3.5-flash"
GEMINI_API_KEY="your-gemini-api-key"
YOUTUBE_API_KEY="your-youtube-data-api-key"
BRIGHT_DATA_API_KEY="your-bright-data-api-key"
BRIGHT_DATA_WEBHOOK_SECRET="use-a-different-long-random-secret"
TIKTOK_COLLECTOR_WEBHOOK_SECRET="use-a-third-long-random-secret"
# Defaults are the current Bright Data profile/post discovery datasets; override when Bright Data rotates them.
BRIGHT_DATA_TIKTOK_DATASET_ID="gd_lu702nij2f790tmv9h"
BRIGHT_DATA_INSTAGRAM_DATASET_ID="gd_l1vikfch901nx3by4"
BRIGHT_DATA_FACEBOOK_DATASET_ID="gd_lkaxegm826bjpoo9m5"

# Public site metadata
NEXT_PUBLIC_SITE_URL="https://360dodep.vn"
NEXT_PUBLIC_GA_ID=""
