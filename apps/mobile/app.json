{
  "expo": {
    "name": "360dep",
    "slug": "360dep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dep360",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF8F5",
    "ios": {
      "bundleIdentifier": "vn.dep360.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "360dep dùng camera để bạn chụp ảnh, quay clip tác phẩm.",
        "NSPhotoLibraryUsageDescription": "360dep mở thư viện ảnh để bạn chọn ảnh, clip tác phẩm và ảnh kết quả khi viết đánh giá.",
        "NSMicrophoneUsageDescription": "360dep dùng micro để ghi tiếng khi bạn quay clip tác phẩm.",
        "LSApplicationQueriesSchemes": [
          "tel",
          "comgooglemaps"
        ]
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "vn.dep360.app",
      "adaptiveIcon": {
        "backgroundColor": "#C9426F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "360dep mở thư viện ảnh để bạn chọn ảnh, clip tác phẩm và ảnh kết quả khi viết đánh giá.",
          "cameraPermission": "360dep dùng camera để bạn chụp ảnh, quay clip tác phẩm.",
          "microphonePermission": "360dep dùng micro để ghi tiếng khi bạn quay clip tác phẩm."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#BB3460"
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "360dep mở thư viện ảnh để bạn chọn ảnh, clip tác phẩm và ảnh kết quả khi viết đánh giá.",
          "savePhotosPermission": "360dep lưu ảnh portfolio vào thư viện để bạn đăng lên mạng xã hội.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "360dep dùng vị trí khi bạn bấm Gửi vị trí trong tin nhắn, để người kia tìm đường tới bạn, và khi bạn ghim địa chỉ trên bản đồ.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68843a7f-0035-4213-b685-152a8d5f5afb"
      }
    },
    "owner": "titanlabs"
  }
}
