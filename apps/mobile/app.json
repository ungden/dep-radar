{
  "expo": {
    "name": "360dep",
    "slug": "360dep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dep360",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF6F4",
    "ios": {
      "bundleIdentifier": "vn.dep360.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "360dep dùng camera để bạn chụp ảnh, quay clip tác phẩm.",
        "NSPhotoLibraryUsageDescription": "360dep mở thư viện ảnh để bạn chọn ảnh, clip tác phẩm và ảnh kết quả khi viết đánh giá.",
        "NSMicrophoneUsageDescription": "360dep dùng micro để ghi tiếng khi bạn quay clip tác phẩm.",
        "LSApplicationQueriesSchemes": [
          "tel",
          "comgooglemaps"
        ]
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "vn.dep360.app",
      "adaptiveIcon": {
        "backgroundColor": "#2A1B1E",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF6F4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "360dep mở thư viện ảnh để bạn chọn ảnh, clip tác phẩm và ảnh kết quả khi viết đánh giá.",
          "cameraPermission": "360dep dùng camera để bạn chụp ảnh, quay clip tác phẩm.",
          "microphonePermission": "360dep dùng micro để ghi tiếng khi bạn quay clip tác phẩm."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#A8535D"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
