{
  "expo": {
    "name": "360dep",
    "slug": "360dep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dep360",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAFAF8",
    "ios": {
      "bundleIdentifier": "vn.dep360.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "360dep dùng camera để bạn chụp ảnh và quay clip tác phẩm.",
        "NSPhotoLibraryUsageDescription": "360dep mở thư viện để bạn chọn ảnh, clip tác phẩm.",
        "NSMicrophoneUsageDescription": "360dep cần micro khi bạn quay clip tác phẩm có tiếng.",
        "LSApplicationQueriesSchemes": ["tel", "comgooglemaps"]
      }
    },
    "android": {
      "package": "vn.dep360.app",
      "adaptiveIcon": {
        "backgroundColor": "#161413",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAFAF8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "360dep mở thư viện để bạn chọn ảnh, clip tác phẩm.",
          "cameraPermission": "360dep dùng camera để bạn chụp ảnh và quay clip tác phẩm.",
          "microphonePermission": "360dep cần micro khi bạn quay clip tác phẩm có tiếng."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#161413"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
